{
  "name": "@t3tools/rooms-agent-connector-host",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "rooms-agent-connector-host": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
